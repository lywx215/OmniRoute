# Copy these names into the Zeabur Docker Service. This file intentionally
# contains no deployable secret values.

# Container runtime
NODE_ENV=production
PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/app/data
APP_LOG_LEVEL=info

# Public HTTPS origin. Replace omniroute.example.com everywhere with one domain.
NEXT_PUBLIC_BASE_URL=https://omniroute.example.com
OMNIROUTE_PUBLIC_BASE_URL=https://omniroute.example.com

# Authentication defaults for an Internet-facing deployment.
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true

# Create these outside Git, enter them only in Zeabur, and keep them private.
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
INITIAL_PASSWORD=

# Keep the live WebSocket private inside the container. Zeabur exposes only
# port 20128; the standalone server proxies the same-origin /live-ws upgrade.
OMNIROUTE_ENABLE_LIVE_WS=1
LIVE_WS_HOST=127.0.0.1
LIVE_WS_PORT=20132
LIVE_WS_PUBLIC_URL=wss://omniroute.example.com/live-ws
LIVE_WS_ALLOWED_ORIGINS=https://omniroute.example.com

# High-risk automation and proxy capabilities stay disabled by default.
OMNIROUTE_BROWSER_POOL=off
WEB_COOKIE_USE_BROWSER=0
PROXY_AUTO_SELECT_ENABLED=false
ONEPROXY_ENABLED=false
OMNIROUTE_CONTROL_PLANE_PROXY_DIRECT_FALLBACK=false
MITM_DISABLE_TLS_VERIFY=0
OMNIROUTE_TURNSTILE_IGNORE_TLS_ERRORS=false
